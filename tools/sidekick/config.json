{
  "project": "test_eds",
  "plugins": [
    {
      "id": "blocks-library",
      "title": "Blocks Library",
      "environments": ["edit"],
      "url": "/tools/sidekick/library.html",
      "includePaths": ["**"]
    },
    {
      "id": "asset-library",
      "title": "AEM Asset Library",
      "environments": [
        "edit","dev"
      ],
      "url": "https://experience.adobe.com/solutions/CQ-assets-selectors/static-assets/resources/franklin/asset-selector.html?rail=false",
      "isPalette": true,
      "includePaths": [
        "**"
      ],
      "paletteRect": "top: 50px; bottom: 10px; right: 10px; left: auto; width:600px; height: calc(100vh - 60px)"
    },
    {
      "id": "tools",
      "title": "Tools",
      "isContainer": true
    },
    {
      "containerId": "tools",
      "id": "contactus",
      "title": "Contact US",
      "environments": [ "edit","dev", "preview", "live", "prod" ],
      "url": "/tools/contactus/contactus.html",
      "isPalette": true,
      "passConfig": false,
      "includePaths": [ "**/:x**" ],
      "paletteRect": "top: 50px; bottom: 10px; right: 10px; left: auto; width:500px; height: calc(100vh - 60px)"
    },
    {
      "containerId": "tools",
      "id": "EDS-Assist",
      "title": "EDS Assist",
      "environments": [ "edit","dev", "preview", "live", "prod"],
      "url": "https://www.aem.live/docs/",
      "isPalette": true,
      "passConfig":true,
      "passReferrer": true,
      "includePaths": [
        "**.docx**"
      ],
      "paletteRect": "top: 50px; bottom: 10px; right: 10px; left: auto; width:400px; height: calc(100vh - 60px)"
    }
  ]
}

